# Copy this file to backend/.env, then fill in the server encryption key.
# Do not commit backend/.env.
#
# The user's AI API URL, API Key, and model are entered in the webpage after login.
# This key encrypts each user's API Key before it is saved in MongoDB.
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=replace_with_fernet_key

# Optional legacy fallback values. User-specific settings take priority.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Google News RSS is used by default for today's source-backed news.
# NEWS_RSS_URL=https://news.google.com/rss/search
